[Unit]
Description=Pochtamt: host agent (postfix queue, dovecot quota)
After=network.target postfix.service dovecot.service

[Service]
User=mailagent
Group=mailagent
EnvironmentFile=/etc/mail-agent.env
ExecStart=/usr/bin/python3 /opt/mail-agent/mail_agent.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=no
# full, а не strict: postsuper/postqueue через sudo должны писать в /var/spool/postfix
ProtectSystem=full
# помощник apply_settings.py (через sudo) пишет конфиги Postfix и Dovecot
ReadWritePaths=/etc/postfix /etc/dovecot
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
# NoNewPrivileges и пустой CapabilityBoundingSet нельзя — sudo должен получать root; остальное закрываем
# (AF_NETLINK нужен postqueue: getifaddrs при старте)
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
