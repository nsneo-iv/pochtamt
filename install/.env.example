# ============================================================================
#  install — значения для шаблонов конфигов (render.py) и install.sh.
#  Скопируйте в .env и заполните. .env в git не попадает. Пароли: openssl rand -hex 24
# ============================================================================

# Имя почтового хоста (HELO, сертификат, MX-запись): A-запись должна указывать на внешний адрес, PTR — обратно
MAIL_HOSTNAME=mail.example.com
# Имя сайта панели администрирования (доступ только из ADMIN_ALLOW_NETS). Может совпадать с MAIL_HOSTNAME
ADMIN_HOSTNAME=mail-admin.example.com
# Сети, откуда пускать в панель и в интерфейс Rspamd (через пробел, формат nginx allow)
ADMIN_ALLOW_NETS="192.168.1.0/24 127.0.0.1"
# «Свои» сети (через пробел): SSH, ManageSieve (4190) и панель открыты в nftables только для них, fail2ban их не банит,
# Rspamd считает письма из них своими (без SPF/greylist, с подписью DKIM). Не шире, чем нужно
LAN_NETS="192.168.1.0/24"

# TLS-сертификат и ключ на хосте. Откуда их берёт install.sh — по порядку:
#   1) TLS_SRC_DIR задан — копирует fullchain.pem и privkey.pem из этого каталога (install/fetch-cert.sh кладёт их
#      туда с другого хоста по SSH);
#   2) иначе CERTBOT_EMAIL задан — выпускает сертификат Let's Encrypt (certbot, HTTP-01 на порту 80; имена
#      CERTBOT_DOMAINS должны резолвиться снаружи на этот хост), продление — таймер certbot;
#   3) иначе — самоподписанный на год (для стенда).
TLS_CERT=/etc/ssl/mail/fullchain.pem
TLS_KEY=/etc/ssl/mail/privkey.pem
TLS_SRC_DIR=
CERTBOT_EMAIL=
# Имена в сертификате Let's Encrypt через пробел; пусто — только MAIL_HOSTNAME. ADMIN_HOSTNAME добавляйте, если
# он резолвится снаружи (панель при этом остаётся закрытой: пускает только ADMIN_ALLOW_NETS)
CERTBOT_DOMAINS=
# Для install/fetch-cert.sh: хост, где уже есть сертификат (например, обратный прокси с ACME), вход по SSH_KEY;
# каталог и имена файлов полной цепочки и ключа в нём
CERT_HOST=
CERT_USER=root
CERT_DIR=
CERT_FULLCHAIN_FILE=fullchain.pem
CERT_KEY_FILE=privkey.pem

# Пароли ролей PostgreSQL: mail_app — бэкенд, mail_postfix — Postfix (только v_postfix_*), mail_dovecot — Dovecot (только v_dovecot_*)
DB_APP_PASSWORD=
DB_POSTFIX_PASSWORD=
DB_DOVECOT_PASSWORD=
# Пароль Redis (requirepass)
REDIS_PASSWORD=
# Пароль веб-интерфейса Rspamd; хеш для конфига считает install.sh (rspamadm pw) и пишет в RSPAMD_PASSWORD_HASH
RSPAMD_PASSWORD=
RSPAMD_PASSWORD_HASH=

# Active Directory — необязательно. Пустой AD_LDAP_URI = AD выключен (ящики только с локальными паролями,
# админы панели — с локальными паролями, таймер синхронизации не включается). Те же значения — в backend/.env.
# ldaps:// — пароли пользователей идут на DC шифрованно; ldap:// — открытым текстом (только стенд).
# Порт 3268/3269 — Global Catalog: поиск по всему лесу без referrals (на 389/636 AD с дочерними доменами отдаёт
# referrals, и libldap в Dovecot на них зависает).
AD_LDAP_URI=
AD_BIND_USER=
AD_BIND_PASSWORD=
AD_BASE_DN=
# Открытая часть сертификата контроллера домена (PEM) для ldaps://, если он самоподписанный или от своего CA:
# install.sh кладёт его в доверенные ОС и останавливается, если LDAPS не проверяется. Выпустить на DC —
# tools/ad-ldaps-cert.ps1; каталог install/certs в git не попадает
AD_CA_CERT=install/certs/ad-ca.pem
# Внутренняя DNS-зона AD и адрес её DNS (контроллер домена): unbound форвардит туда зону без DNSSEC, чтобы
# имя DC из AD_LDAP_URI резолвилось. Пусто — не нужно
AD_DNS_ZONE=
AD_FORWARD_DNS=
# Обратные зоны, которые тоже ведёт DNS домена (через пробел), например «10.in-addr.arpa»
AD_REVERSE_ZONES=

# Зеркала баз ClamAV через пробел, по порядку. Подлинность баз проверяется подписью ClamAV: зеркало может быть
# только устаревшим, но не подменённым. Если database.clamav.net отдаёт 403 (блокировка CDN по региону) —
# поставьте первым доступное зеркало
CLAMAV_MIRRORS="database.clamav.net"

# SOGo (необязательно): календарь, контакты, веб-почта, ActiveSync в Docker на этом же хосте (docs/calendar.md).
# Имя сайта (A-запись на этот хост, отличается от ADMIN_HOSTNAME; попадёт в сертификат certbot). Пусто — не ставится
SOGO_HOSTNAME=
# Пароль роли PostgreSQL sogo (своя база sogo + чтение v_sogo_users из mail)
DB_SOGO_PASSWORD=
# Часовой пояс календаря по умолчанию и число воркеров sogod (по одному на устройство с push ActiveSync + запас)
SOGO_TIMEZONE=UTC
SOGO_WORKERS=5
# Зеркала Docker Hub через пробел, если прямой доступ закрыт (например https://mirror.gcr.io); пусто — напрямую
DOCKER_REGISTRY_MIRRORS=

# Пароль master-пользователя Dovecot «panel»: через него бэкенд управляет Sieve-скриптами
# пользователей по ManageSieve (логин «ящик*panel»). Тот же пароль — SIEVE_MASTER_PASSWORD в backend/.env
SIEVE_MASTER_PASSWORD=

# Для install/deploy.sh с рабочего ПК: адрес сервера, пользователь с sudo и SSH-ключ
VM_HOST=
VM_USER=admin
SSH_KEY=~/.ssh/id_ed25519
