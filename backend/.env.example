# ============================================================================
#  backend — бэкенд API панели. Скопируйте в .env и заполните. .env в git не попадает.
#  Переменные окружения с теми же именами имеют приоритет над .env.
# ============================================================================

# Строка подключения к PostgreSQL под ролью mail_app (пароль — DB_APP_PASSWORD из install/.env)
DB_DSN=postgresql://mail_app:ПАРОЛЬ@127.0.0.1:5432/mail

# Секрет подписи JWT сессий панели: любая случайная строка 32+ символов (openssl rand -hex 32)
JWT_SECRET=
# Время жизни сессии, минут
JWT_TTL_MINUTES=120

# Active Directory — необязательно. Пустой AD_LDAP_URI = AD выключен: админы входят по локальному паролю
# (python -m app.cli admin-add admin superadmin --password), ящики только auth=local, синхронизации нет.
# ldaps:// — если у контроллера есть сертификат (его открытая часть — в доверенных ОС, см. AD_CA_CERT в install/.env);
# ldap:// отправляет пароли пользователей на DC открытым текстом — только для стенда.
# Порт 3268/3269 — Global Catalog: поиск по всему лесу без referrals (на 389/636 AD с дочерними доменами отдаёт
# referrals, и libldap в Dovecot на них зависает).
AD_LDAP_URI=
# Сервисная учётка для поиска (bind), UPN, с правом чтения пользователей и групп
AD_BIND_USER=
AD_BIND_PASSWORD=
# База поиска
AD_BASE_DN=
# Суффикс UPN для коротких логинов (user -> user@corp.local) и NetBIOS-имя домена для логинов вида CORP\user
AD_UPN_SUFFIX=
AD_NETBIOS=
# Проверять сертификат DC (false только на стенде)
AD_TLS_VERIFY=true

# Имя почтового хоста (как MAIL_HOSTNAME в install/.env): дашборд домена проверяет, что MX указывает на него
MAIL_HOSTNAME=mail.example.com

# Контроллер Rspamd (статистика антиспама и антивируса в сводке); пароль — RSPAMD_PASSWORD из install/.env
RSPAMD_URL=http://127.0.0.1:11334
RSPAMD_PASSWORD=

# Redis (ключи DKIM для Rspamd, счётчики неудачных входов); пароль — REDIS_PASSWORD из install/.env
REDIS_URL=redis://:ПАРОЛЬ@127.0.0.1:6379/0

# ManageSieve (автоответ и правила ящиков): хост с сертификатом, порт 4190, master-пользователь Dovecot
# и его пароль — SIEVE_MASTER_PASSWORD из install/.env
SIEVE_HOST=mail.example.com
SIEVE_PORT=4190
SIEVE_MASTER_USER=panel
SIEVE_MASTER_PASSWORD=

# Агент на почтовом хосте (agent/mail_agent.py): адрес и общий токен (AGENT_TOKEN из agent/.env)
AGENT_URL=http://127.0.0.1:8025
AGENT_TOKEN=

# Где слушать uvicorn (за nginx — только localhost)
LISTEN_HOST=127.0.0.1
LISTEN_PORT=8000
# Разрешённые Origin для CORS, JSON-список; пусто — фронт отдаётся тем же nginx, CORS не нужен
CORS_ORIGINS=[]
