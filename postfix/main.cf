# ============================================================================
#  Postfix — шаблон main.cf. Плейсхолдеры @...@ подставляет install/render.py из install/.env.
#  Все данные о доменах/ящиках/алиасах берутся из PostgreSQL (postfix/pgsql/*.cf), файлов карт нет.
# ============================================================================

compatibility_level = 3.9
myhostname = @MAIL_HOSTNAME@
myorigin = $myhostname
mydestination =
# локальных пользователей нет — таблица /etc/aliases не нужна
alias_maps =
alias_database =
mynetworks = 127.0.0.0/8 [::1]/128
inet_interfaces = all
inet_protocols = ipv4
biff = no
append_dot_mydomain = no
readme_directory = no
message_size_limit = 52428800
mailbox_size_limit = 0
recipient_delimiter = +
smtpd_banner = $myhostname ESMTP
disable_vrfy_command = yes
smtpd_helo_required = yes

# ---------------------------------------------------------------- TLS -------
smtpd_tls_cert_file = @TLS_CERT@
smtpd_tls_key_file = @TLS_KEY@
smtpd_tls_security_level = may
smtpd_tls_auth_only = yes
smtpd_tls_protocols = >=TLSv1.2
smtpd_tls_mandatory_protocols = >=TLSv1.2
smtpd_tls_ciphers = high
smtpd_tls_mandatory_ciphers = high
smtpd_tls_session_cache_database = btree:${data_directory}/smtpd_scache
smtpd_tls_received_header = yes
tls_preempt_cipherlist = yes
tls_ssl_options = NO_COMPRESSION, NO_RENEGOTIATION

smtp_tls_security_level = dane
smtp_dns_support_level = dnssec
smtp_tls_protocols = >=TLSv1.2
smtp_tls_session_cache_database = btree:${data_directory}/smtp_scache
smtp_tls_loglevel = 1

# ---------------------------------------------------------------- виртуальные домены (PostgreSQL) ----
virtual_mailbox_domains = pgsql:/etc/postfix/pgsql/virtual_mailbox_domains.cf
virtual_mailbox_maps = pgsql:/etc/postfix/pgsql/virtual_mailbox_maps.cf
virtual_alias_maps = pgsql:/etc/postfix/pgsql/virtual_alias_maps.cf,
                     pgsql:/etc/postfix/pgsql/virtual_alias_domains.cf
virtual_transport = lmtp:unix:private/dovecot-lmtp
# транспорт по домену / smarthost, TLS-политики и скрытые копии — из панели (база)
transport_maps = pgsql:/etc/postfix/pgsql/transport_maps.cf
smtp_tls_policy_maps = pgsql:/etc/postfix/pgsql/tls_policy_maps.cf
recipient_bcc_maps = pgsql:/etc/postfix/pgsql/bcc_maps.cf
sender_bcc_maps = pgsql:/etc/postfix/pgsql/bcc_maps.cf
# авторизация на smarthost (если он задан в панели)
smtp_sasl_auth_enable = yes
smtp_sasl_password_maps = pgsql:/etc/postfix/pgsql/sasl_password_maps.cf
# логин/пароль smarthost не уходят открытым текстом: PLAIN/LOGIN только внутри TLS
smtp_sasl_security_options = noanonymous, noplaintext
smtp_sasl_tls_security_options = noanonymous
virtual_mailbox_base = /var/vmail
virtual_minimum_uid = 5000
virtual_uid_maps = static:5000
virtual_gid_maps = static:5000

# ---------------------------------------------------------------- SASL через Dovecot ----
smtpd_sasl_type = dovecot
smtpd_sasl_path = private/auth
smtpd_sasl_auth_enable = no
smtpd_sasl_security_options = noanonymous
smtpd_sasl_local_domain = $myhostname
broken_sasl_auth_clients = yes
smtpd_sender_login_maps = pgsql:/etc/postfix/pgsql/sender_login_maps.cf

# ---------------------------------------------------------------- ограничения ----
smtpd_client_restrictions =
    check_client_access pgsql:/etc/postfix/pgsql/client_access.cf,
    permit_mynetworks,
    permit_sasl_authenticated,
    reject_unknown_reverse_client_hostname

smtpd_helo_restrictions =
    permit_mynetworks,
    permit_sasl_authenticated,
    reject_invalid_helo_hostname,
    reject_non_fqdn_helo_hostname

smtpd_sender_restrictions =
    permit_mynetworks,
    reject_authenticated_sender_login_mismatch,
    check_sender_access pgsql:/etc/postfix/pgsql/sender_access.cf,
    permit_sasl_authenticated,
    reject_non_fqdn_sender,
    reject_unknown_sender_domain

# класс для ящиков/доменов «только внутрь»: получатель в наших доменах — ок, иначе отказ
smtpd_restriction_classes = internal_only
internal_only = check_recipient_access pgsql:/etc/postfix/pgsql/recipient_internal.cf, reject

smtpd_recipient_restrictions =
    check_recipient_access pgsql:/etc/postfix/pgsql/recipient_access.cf,
    permit_mynetworks,
    permit_sasl_authenticated,
    reject_non_fqdn_recipient,
    reject_unknown_recipient_domain,
    reject_unauth_destination,
    reject_unlisted_recipient

smtpd_relay_restrictions =
    permit_mynetworks,
    permit_sasl_authenticated,
    reject_unauth_destination

smtpd_data_restrictions = reject_unauth_pipelining

# защита от перебора и флуда
smtpd_client_connection_rate_limit = 30
smtpd_client_message_rate_limit = 100
smtpd_client_recipient_rate_limit = 300
smtpd_error_sleep_time = 5s
smtpd_soft_error_limit = 5
smtpd_hard_error_limit = 10
anvil_rate_time_unit = 60s

# ---------------------------------------------------------------- Rspamd (milter) ----
smtpd_milters = inet:127.0.0.1:11332
non_smtpd_milters = $smtpd_milters
milter_protocol = 6
# при недоступном Rspamd письма не принимаем без проверки на спам/вирусы и без DKIM-подписи — отправитель повторит позже
milter_default_action = tempfail
milter_mail_macros = i {mail_addr} {client_addr} {client_name} {auth_authen}

# ---------------------------------------------------------------- прочее ----
maillog_file = /var/log/postfix.log
smtp_helo_name = $myhostname
smtp_address_preference = ipv4
