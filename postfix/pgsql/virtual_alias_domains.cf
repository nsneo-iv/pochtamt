# доменные алиасы: user@alias_domain -> user@target_domain.
# Запрос ищет по домену (%d), адрес собирается в result_format: %u — локальная часть запроса, %s — результат.
hosts = 127.0.0.1
user = mail_postfix
password = @DB_POSTFIX_PASSWORD@
dbname = mail
query = SELECT target_domain FROM v_postfix_alias_domains WHERE alias_domain = '%d'
result_format = %u@%s
