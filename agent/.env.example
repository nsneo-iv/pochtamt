# ============================================================================
#  agent — агент на почтовом хосте. Скопируйте в .env и заполните. .env в git не попадает.
# ============================================================================

# Общий токен с бэкендом (тот же, что AGENT_TOKEN в backend/.env), 32+ символов: openssl rand -hex 32
AGENT_TOKEN=
# Где слушать; только localhost, наружу агент не публикуется
AGENT_LISTEN=127.0.0.1:8025
